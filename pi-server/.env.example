# Raspberry Pi environment
#
# Copy to .env and fill in. .env is git-ignored — never commit real keys.

# Supabase project URL, no trailing slash
SUPABASE_URL=https://your-project-ref.supabase.co

# service_role / secret key. The Pi uses this only for server-to-server
# calls to the Edge Function and the REST API, never from a browser.
SUPABASE_SECRET_KEY=your-service-role-key

# Dedicated service_role key for the ingest-reading Edge Function.
# Falls back to SUPABASE_SECRET_KEY if unset.
SUPABASE_SERVICE_ROLE_KEY=

# Device timezone used for phase windows and reading timestamps
LPMAS_TIMEZONE=Asia/Manila
