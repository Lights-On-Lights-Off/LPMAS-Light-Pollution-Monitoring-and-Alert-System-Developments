[Unit]
Description=LPMAS Raspberry Pi Flask backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/lpmas/pi-server
ExecStart=/usr/bin/python3 /home/pi/lpmas/pi-server/app.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target