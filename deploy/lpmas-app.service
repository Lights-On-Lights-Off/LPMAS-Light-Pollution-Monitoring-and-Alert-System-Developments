[Unit]
Description=LPMAS Raspberry Pi Flask backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/lpmas/pi-server
ExecStart=/usr/bin/python3 /home/pi/lpmas/pi-server/app.py
Restart=on-failure
RestartSec=5
RuntimeDirectory=lpmas
RuntimeDirectoryMode=0700
ExecStartPre=/usr/bin/python3 /home/pi/lpmas/pi-server/local_sms_clock.py
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true

[Install]
WantedBy=multi-user.target
